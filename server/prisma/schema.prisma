datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  country      String    @default("US")
  createdAt    DateTime  @default(now())
  profiles     Profile[]
}

model Profile {
  id                      String   @id @default(cuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                    String
  avatarColor             String?
  defaultWatchProviderIds String   @default("[]")
  isUnder18               Boolean  @default(false)
  isPrimary               Boolean  @default(false)
  createdAt               DateTime @default(now())
  ratings                 Rating[]
  watchlist               WatchlistEntry[]

  @@index([userId])
}

model Rating {
  id         String    @id @default(cuid())
  profileId  String
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tmdbId     Int
  mediaType  String // "movie" | "tv"
  value      Int
  title      String
  posterPath String?
  genreIds   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([profileId, tmdbId, mediaType])
  @@index([profileId])
}

model WatchlistEntry {
  id         String   @id @default(cuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tmdbId     Int
  mediaType  String // "movie" | "tv"
  title      String
  posterPath String?
  genreIds   String
  createdAt  DateTime @default(now())

  @@unique([profileId, tmdbId, mediaType])
  @@index([profileId])
}
