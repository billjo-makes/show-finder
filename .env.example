# Copy this into server/.env and fill in real values.
# Sign up for a free TMDB account at https://www.themoviedb.org/,
# then generate a v3 API key under Settings -> API before running the server.

TMDB_API_KEY=your_tmdb_v3_api_key_here

# Optional. Without it, title detail simply omits the external ratings row.
# Get a free key (instant, but requires clicking an activation link emailed
# to you) at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here

JWT_SECRET=some_long_random_string
DATABASE_URL=file:./dev.db
PORT=4000
CLIENT_URL=http://localhost:5173
